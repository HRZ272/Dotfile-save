
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/cachy.png",
        "cache": "regen",
        "type": "auto",
        "height": 15,
        "preserveAspectRatio": true,
        "padding": {
            "top": 0,
            "right": 2,
            "left": 1
        }
    },

    "display": {
        "separator": " "
    },

    "modules": [
        {
            "type": "title",
            "outputColor": "bright_magenta",
            "format": "\u001b[38;2;105;75;155m┌────────────────────────────────────────────┐"
        },
        {
            "type": "host",
            "key": " Host",
            "keyColor": "#A879E8",
            "outputColor": "#D5C4FF",
            "format": "{name}"
        },
        {
            "type": "display",
            "key": "│󰹑 Display",
            "keyColor": "#A879E8",
            "outputColor": "#C7B1FF",
            "format": "{name} {width}x{height} @ {refresh-rate}Hz {inch}″"
        },
        {
            "type": "cpu",
            "key": "│󰻠 CPU",
            "keyColor": "#A879E8",
            "outputColor": "#D5C4FF",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "│󰍛 GPU",
            "keyColor": "#A879E8",
            "outputColor": "#C7B1FF",
            "format": "{vendor} {name}"
        },
        {
            "type": "memory",
            "key": "│󰘚 RAM",
            "keyColor": "#A879E8",
            "outputColor": "#D5C4FF"
        },
        {
            "type": "disk",
            "key": "│󰋊 Disk",
            "keyColor": "#A879E8",
            "outputColor": "#C7B1FF",
            "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;105;75;155m├────────────────────────────────────────────┤"
        },
        {
            "type": "os",
            "key": "󰌽 OS",
            "keyColor": "#B58AFF",
            "outputColor": "#E0D0FF"
        },
        {
            "type": "de",
            "key": "│ DE",
            "keyColor": "#B58AFF",
            "outputColor": "#D5C4FF"
        },
        {
            "type": "wm",
            "key": "│ WM",
            "keyColor": "#B58AFF",
            "outputColor": "#D5C4FF"
        },
        {
            "type": "kernel",
            "key": "│ Kernel",
            "keyColor": "#B58AFF",
            "outputColor": "#E0D0FF"
        },
        {
            "type": "packages",
            "key": "│󰏖 Packages",
            "keyColor": "#B58AFF",
            "outputColor": "#D5C4FF"
        },
        {
            "type": "shell",
            "key": "│ Shell",
            "keyColor": "#B58AFF",
            "outputColor": "#E0D0FF"
        },
        {
            "type": "command",
            "key": "│ Age",
            "keyColor": "#B58AFF",
            "outputColor": "#D5C4FF",
            "text": "echo $((($(date +%s) - $(stat -c %W /)) / 86400)) days"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;105;75;155m└────────────────────────────────────────────┘"
        }
    ]
}
